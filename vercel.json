{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/blog",
      "destination": "https://wp-origin.tofamacseo.com/blog"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://wp-origin.tofamacseo.com/blog/:path*"
    }
  ]
}
