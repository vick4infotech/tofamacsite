ADMIN_PASSWORD=ChangeThisDemoPassword_2026!
# Generate a unique 32+ character random secret; example only, DO NOT DEPLOY this value:
ADMIN_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
